# Copy to .env and adjust. Never commit secrets.

# Set ENVIRONMENT=production on hosted API/worker. That rejects localhost DATABASE_URL
# and the default API token. The web app is hosted separately and talks to the API
# through INTERNAL_API_URL (server-only).
ENVIRONMENT=development

# Database (local default is fine in development only)
DATABASE_URL=postgresql+psycopg://shelfready:shelfready@localhost:55433/shelfready

# API auth — server-only. Do not put this in NEXT_PUBLIC_* variables.
SHELFREADY_API_TOKEN=dev-token-change-me
# Next.js server uses this to call the API. Defaults to SHELFREADY_API_TOKEN if unset.
API_TOKEN=dev-token-change-me
# Optional distinct operator unlock token for the web BFF session.
OPERATOR_ACCESS_TOKEN=dev-token-change-me

# Agent mode: live | replay
# live  = Strands + Amazon Bedrock (requires AWS credentials + model access)
# replay = deterministic fixture path through the same services (no model calls)
# Agent mode and lookup mode are independent and labeled separately in the UI.
AGENT_MODE=replay

# Amazon Bedrock (live mode only)
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Storage
STORAGE_ROOT=./storage
FIXTURES_ROOT=./fixtures

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

LOOKUP_PROVIDER=replay
UPCITEMDB_API_KEY=
LOOKUP_BUDGET_PER_RUN=25
LOOKUP_TIMEOUT_SECONDS=10
LOOKUP_MAX_RETRIES=2

# Web (server-only). Browser calls same-origin /api and never sees the API token.
# In production INTERNAL_API_URL is required and must not be localhost.
INTERNAL_API_URL=http://127.0.0.1:8000

# Dokploy (optional — for scripts/dokploy-*.py)
DOKPLOY_URL=https://your-dokploy-instance.com
DOKPLOY_API_KEY=
