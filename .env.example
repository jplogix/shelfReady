# Copy to .env and adjust. Never commit secrets.

# Database
DATABASE_URL=postgresql+psycopg://shelfready:shelfready@localhost:55433/shelfready

# API auth (operator + storefront API calls)
SHELFREADY_API_TOKEN=dev-token-change-me

# Agent mode: live | replay
# live  = Strands + Amazon Bedrock (requires AWS credentials + model access)
# replay = deterministic fixture path through the same services (no model calls)
AGENT_MODE=replay

# Amazon Bedrock (live mode only)
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# Storage
STORAGE_ROOT=./storage
FIXTURES_ROOT=./fixtures

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TOKEN=dev-token-change-me
